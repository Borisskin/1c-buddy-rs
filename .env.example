# Личный токен «1С:Напарника»
# Сервер не читает этот файл автоматически: он получает настройки только
# из окружения своего процесса.
#
# ONEC_AI_TOKEN можно задать как переменную пользователя Windows либо как
# системную переменную Windows. После изменения полностью перезапустите
# программу, которая запускает сервер.
#
# Если ONEC_AI_TOKEN уже задана для пользователя или системы, не задавайте
# ONEC_AI_TOKEN и ONEC_AI_TOKEN_FILE ниже.
#
# Если токен передаёт программа запуска, укажите ровно один источник:
# ONEC_AI_TOKEN=вставьте_личный_токен
# ONEC_AI_TOKEN_FILE=C:\Secrets\onec-ai-token.txt

# Ограничения длины входных данных инструментов MCP
MCP_TOOL_INPUT_MIN_LENGTH=4
MCP_TOOL_INPUT_MAX_LENGTH=100000

# Режим вызова инструментов: direct или standard
MCP_TOOL_CALL_MODE=direct

# Язык ответов и необязательный язык программирования
ONEC_AI_UI_LANGUAGE=russian
ONEC_AI_PROGRAMMING_LANGUAGE=

# Необязательный контекст 1С
DEFAULT_SSL_VERSION=
DEFAULT_1C_CONFIGURATION=

# Число одновременно выполняемых вызовов: 1 или 2
MCP_MAX_CONCURRENT_CALLS=2

# Уровень журналирования
RUST_LOG=warn
